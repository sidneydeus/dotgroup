# Environment variables for the chatbot backend
# Copy this file to .env and fill in the values

# Groq API Key (required for LLM integration)
GROQ_API_KEY=

# Groq Model (optional, defaults to openai/gpt-oss-20b)
GROQ_MODEL=openai/gpt-oss-20b

# LangSmith Configuration (optional, for observability)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chatbot-python
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true

# Server configuration
HOST=0.0.0.0
PORT=8000
RELOAD=true